# ──────────────────────────────────────────────────
# FoodLoop Backend — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit a filled .env file.
# ──────────────────────────────────────────────────

# ── Database (TiDB / MySQL) ───────────────────────
# For local MySQL: host=localhost, port=3306
# For TiDB Cloud: host=gateway01.<region>.prod.aws.tidbcloud.com, port=4000
FOODLOOP_DB_HOST=localhost
FOODLOOP_DB_PORT=3306
FOODLOOP_DB_NAME=foodloop
FOODLOOP_DB_USERNAME=foodloop_user
FOODLOOP_DB_PASSWORD=foodloop_password

# ── Brevo HTTPS Email API ─────────────────────────
# Get your API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Sender name displayed on outgoing emails (e.g. FoodLoop)
BREVO_FROM_NAME=FoodLoop
# Sender email verified in your Brevo account (e.g. noreply@yourdomain.com or your Brevo sender)
BREVO_FROM_EMAIL=
# Destination for contact and feedback form submissions
FOODLOOP_FEEDBACK_TO=harshitsinghh1128@gmail.com

# ── JWT ──────────────────────────────────────────
# Secret: at least 64 hex chars (256-bit).
# Generate one: openssl rand -hex 32
FOODLOOP_JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Token lifetime in milliseconds (default: 24 h)
FOODLOOP_JWT_EXPIRATION_MS=86400000

# ── Frontend / CORS ─────────────────────────────
FOODLOOP_FRONTEND_URL=http://localhost:3000

# ── Dev mode ─────────────────────────────────────
# When true and Brevo is not configured, logs verification links to console.
# Set to false in production.
FOODLOOP_DEV_LOG_VERIFICATION_LINK=false
